# Server
PORT=3000
NODE_ENV=development

# Database (Supabase or local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/memorial_app

# Storage (Supabase Storage or Cloudflare R2)
STORAGE_ENDPOINT=https://your-storage-endpoint.com
STORAGE_BUCKET=memorial-assets
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key

# OpenAI (server-side only)
OPENAI_API_KEY=sk-your-openai-key

# Google Auth
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Google Play Billing verification
GOOGLE_PLAY_PACKAGE_NAME=com.example.memorialapp
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json

# Session
SESSION_SECRET=your_random_session_secret_min_32_chars

# Frontend URL (for CORS)
ALLOWED_ORIGINS=http://localhost:8080
