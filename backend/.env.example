# Server
PORT=3000
NODE_ENV=development

# Database (Supabase Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/memorial_app

# Storage (Cloudflare R2 / S3-compatible)
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_BUCKET=memora-uploads
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key
STORAGE_PUBLIC_DOMAIN=https://images.yourdomain.com
STORAGE_SIGNED_URL_EXPIRES=900

# Auth
JWT_SECRET=your_random_jwt_secret_min_32_chars
USE_MOCK_AUTH=false

# Google Auth
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Google Play Billing verification
GOOGLE_PLAY_PACKAGE_NAME=com.memora.familyphotos
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=base64_encoded_service_account_json

# Image Generation Provider (mock | openai | ...)
IMAGE_GENERATION_PROVIDER=mock

# OpenAI (server-side only)
OPENAI_API_KEY=sk-your-openai-key

# Sentry
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=development

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREVIEW_PACK=price_...
STRIPE_PRICE_HD_UNLOCK=price_...
STRIPE_PRICE_FULL_PACK=price_...

# Web App URL (for Stripe redirect URLs)
WEB_APP_URL=http://localhost:3000

# Frontend URL (for CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
